config {
  type: "view",
  schema: "staging",
  tags: ["pya", "innovaweb"],
  description: "Reembolsos Innovaweb; por (cc, fecha_reporte) manda el último archivo ingestado."
}

WITH archivo_vigente AS (
  SELECT cc, fecha_reporte, ARRAY_AGG(_archivo_id ORDER BY _ingestado_en DESC LIMIT 1)[OFFSET(0)] AS archivo_id
  FROM ${ref("innovaweb_reembolsos")}
  GROUP BY cc, fecha_reporte
)

SELECT
  r.cc, r.sucursal, r.fecha_reporte, r.tipo_recaudacion, r.agregador, r.agregador_norm,
  r.codigo_orden, r.numero_boleta, r.valor, r.fecha_ingreso_reembolso, r._archivo_id
FROM ${ref("innovaweb_reembolsos")} AS r
JOIN archivo_vigente AS v ON r.cc = v.cc AND r.fecha_reporte = v.fecha_reporte AND r._archivo_id = v.archivo_id
